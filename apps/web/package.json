{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sw": "esbuild src/sw.ts --bundle --format=iife --target=es2022 --minify --outfile=public/sw.js",
    "dev": "pnpm build:sw && next dev",
    "build": "pnpm build:sw && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/ui": "workspace:*",
    "better-auth": "^1.7.1",
    "next": "^16.3.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3"
  }
}
